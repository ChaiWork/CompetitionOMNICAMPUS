   "source": [
    "# Divide OWN_CAR_AGE into groups\n",
    "train[\"OWN_CAR_AGE\"] = train[\"OWN_CAR_AGE\"] // 10\n",
    "test[\"OWN_CAR_AGE\"] = test[\"OWN_CAR_AGE\"] // 10\n",
    "\n",
    "train[\"OWN_CAR_AGE\"].unique()"
   ]
